# Copy to private/secrets.env; fill privately on the server. Never commit it.
AUTH_PEPPER=
# Keep the filled hash single-quoted: PBKDF2 hashes contain literal $ characters.
ADMIN_PASSWORD_HASH=''
TEXTBOOK_IMAGE_KEY=
# Optional: use the administrator's AI settings page instead of environment variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
